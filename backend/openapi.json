{
  "openapi": "3.0.0",
  "info": {
    "title": "CSMJU Tools Shortcut Hub API",
    "version": "1.0.0",
    "description": "API for CSMJU Tools Shortcut Hub"
  },
  "servers": [
    {
      "url": "http://localhost:4238/api/v1"
    }
  ],
  "paths": {
    "/quick-links": {
      "get": {
        "summary": "Get all quick links",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "category",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "targetYear",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Create a quick link",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/quick-links/{id}": {
      "get": {
        "summary": "Get quick link by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "patch": {
        "summary": "Update quick link by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      },
      "delete": {
        "summary": "Delete quick link by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/quick-links/{id}/click": {
      "post": {
        "summary": "Track a click on a quick link",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "201": { "description": "Success" }
        }
      }
    }
  }
}
